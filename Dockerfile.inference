# Imagem da INFERÊNCIA: API que serve um modelo do MLflow Registry.
# Instala só o grupo `serving` (sem DVC, boto3, matplotlib nem o MLflow completo), então é
# bem menor que a do trainer (Dockerfile). Não carrega modelo nem dados: o modelo é baixado
# do MLflow na subida, conforme a variável MODEL_VERSION (`champion` ou o número da versão).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app \
    && chown app:app /app

USER app
WORKDIR /app

# Dependências primeiro: a camada fica em cache enquanto pyproject.toml e uv.lock não mudam
COPY --chown=app:app pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-default-groups --group serving --no-install-project

COPY --chown=app:app src ./src
RUN uv sync --frozen --no-default-groups --group serving

EXPOSE 8000

CMD ["uvicorn", "pos_mle_tech_challenge_2.serving.api:create_app_from_env", \
     "--factory", "--host", "0.0.0.0", "--port", "8000"]
