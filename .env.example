# Copie para .env e ajuste conforme necessário: cp .env.example .env
# Hiperparâmetros, seed e split NÃO ficam aqui: ficam em params.yaml.

# --- MLflow ---
# Backend de tracking e Model Registry (o Registry exige um banco, aqui SQLite).
# No host, o padrão (SQLite local) é o recomendado. O trainer do docker compose usa o
# servidor MLflow do compose (http://mlflow:5000, definido no próprio compose).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=purchase-propensity
MLFLOW_REGISTERED_MODEL_NAME=purchase-propensity-classifier
# Alias promovido no Registry
MLFLOW_CHAMPION_ALIAS=champion

# --- Dados ---
# Entrada do pipeline (versionada pelo DVC) e saída do estágio preprocess
DATA_RAW_PATH=data/raw/online_shoppers_intention.csv
DATA_PROCESSED_DIR=data/processed

# --- Aplicação ---
LOG_LEVEL=INFO

# --- Inferência ---
# Modelo que a API carrega: champion (segue o alias do Registry) ou o número de uma versão
MODEL_VERSION=champion

# --- Infra local (docker compose): RustFS (S3 compatível) ---
# Credenciais APENAS para desenvolvimento local; o compose usa estes valores por padrão.
RUSTFS_ACCESS_KEY=devadmin
RUSTFS_SECRET_KEY=devadmin-secret
